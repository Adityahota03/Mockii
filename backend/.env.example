# =============================================================
# .env.example  —  Mockii backend environment variables
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# =============================================================

# Django core
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Hosts & origins (comma-separated for multiple values)
ALLOWED_HOSTS=api.mockii.example.com
CORS_ALLOWED_ORIGINS=https://mockii.example.com
CSRF_TRUSTED_ORIGINS=https://mockii.example.com

# Database
# Use the dedicated least-privilege login role, NOT the postgres superuser.
# See scripts/db_setup_roles.sql for role creation instructions.
DB_NAME=mockii_db
DB_USER=mockii_app_login
DB_PASSWORD=replace-with-real-password
DB_HOST=localhost
DB_PORT=5432

# Email (leave blank to keep the console backend for dev)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=replace-with-real-password
# DEFAULT_FROM_EMAIL=Mockii <no-reply@mockii.example.com>

# AWS S3 (leave blank to use local filesystem storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
# AWS_QUERYSTRING_EXPIRE=300

# HSTS — enable ONLY after HTTPS is fully verified in production
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Logging
# LOG_LEVEL=INFO
